{
  "manifest_version": 3,
  "name": "Spotify Miniplayer Lyrics",
  "version": "0.5.8",
  "description": "Adds a synced lyrics panel to the Spotify web player's miniplayer (picture-in-picture window). Sources: Spotify's own lyrics, LRCLIB, lyrics.ovh, optional NetEase.",
  "permissions": ["storage"],
  "host_permissions": ["https://lrclib.net/*", "https://api.lyrics.ovh/*", "https://music.xianqiao.wang/*"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
